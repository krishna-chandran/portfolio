{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- $rest := slice -}}
{{- range .Site.Pages -}}
  {{- if and (not .IsHome) (ne .Kind "taxonomy") (ne .Kind "term") (ne .Section "folio") (ne .Section "news") -}}
    {{- $rest = $rest | append . -}}
  {{- end -}}
{{- end -}}
{{- range (sort $rest "Lastmod" "desc") -}}
{{- partial "sitemap-url.html" (dict "page" .) -}}
{{- end -}}
</urlset>
